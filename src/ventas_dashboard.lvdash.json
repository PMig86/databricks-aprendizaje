      "displayName": "ventas_sql",
      "name": "2f8607b4"
    },
    {
      "displayName": "ventas_mensuales_ds",
      "name": "16ca1b94",
      "queryLines": [
        "SELECT mes, ciudad, ventas, pedidos\r\n",
        "FROM workspace.poll_cedeno.ventas_mensuales"
      ]
    },
    {
      "displayName": "ventas_producto_ds",
      "name": "35560149",
      "queryLines": [
        "SELECT producto,\r\n",
        "       SUM(cantidad * precio_unitario) AS ventas,\r\n",
        "       SUM(cantidad) AS unidades\r\n",
        "FROM workspace.poll_cedeno.pedidos\r\n",
        "GROUP BY producto"
      ]
    },
    {
      "displayName": "kpis_ds",
      "name": "fd1b2a42",
      "queryLines": [
        "SELECT SUM(cantidad * precio_unitario) AS ventas_totales,\r\n",
        "       COUNT(*) AS pedidos,\r\n",
        "       ROUND(AVG(cantidad * precio_unitario), 2) AS ticket_promedio\r\n",
        "FROM workspace.poll_cedeno.pedidos"
      ]
    }
  ],
